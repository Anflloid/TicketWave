Person(controller, "Контролер на вході", "Сканує QR-коди квитків")
Person(admin, "Адміністратор", "Модерує події, блокує підозрілі акаунти")

System(tw, "TicketWave", "Платформа продажу квитків з інтерактивною схемою залу і захистом від перекупників")

System_Ext(pay, "LiqPay", "Платіжний сервіс")
