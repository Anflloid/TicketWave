Rel(buyer, tw, "Купує квитки, отримує QR-код", "HTTPS")
Rel(organizer, tw, "Керує подіями, дивиться статистику", "HTTPS")
Rel(controller, tw, "Перевіряє квитки", "HTTPS")
Rel(admin, tw, "Модерує, блокує акаунти", "HTTPS")

Rel(tw, pay, "Створює платіж, отримує результат", "HTTPS/JSON")
Rel(tw, email, "Надсилає квитки і листи", "HTTPS/JSON")
Rel(tw, push, "Надсилає сповіщення", "HTTPS/JSON")
Rel(tw, captcha, "Перевіряє токен CAPTCHA", "HTTPS/JSON")
Rel(gates, tw, "Перевіряє QR-код", "HTTPS/JSON")

@enduml
